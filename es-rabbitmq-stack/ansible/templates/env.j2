# {{ ansible_managed }}
STACK_NAME=es-stack
COMPOSE_FILE=compose.yaml:compose.acme-{{ stack_acme_mode }}.yaml
TRAEFIK_VERSION={{ traefik_version }}
ES_VERSION={{ es_version }}
RABBITMQ_VERSION={{ rabbitmq_version }}
ES_WRITER_IMAGE={{ es_writer_image }}
ES_DOMAIN={{ es_domain }}
RMQ_DOMAIN={{ rmq_domain }}
ACME_EMAIL={{ acme_email }}
{% if acme_ca_server is defined %}ACME_CA_SERVER={{ acme_ca_server }}
{% endif %}
ACME_DNS_PROVIDER={{ acme_dns_provider | default('cloudflare') }}
ES_ALLOWED_CIDRS={{ es_allowed_cidrs }}
RMQ_MGMT_ALLOWED_CIDRS={{ rmq_mgmt_allowed_cidrs }}
AMQP_ALLOWED_CIDRS={{ amqp_allowed_cidrs }}
ES_CLUSTER_NAME={{ es_cluster_name | default('es-cluster') }}
ES_HEAP={{ es_heap }}
ES_MEM_LIMIT={{ es_mem_limit }}
ES_CPUS={{ es_cpus | default(2) }}
ES_REPLICAS={{ es_replicas | default(0) }}
ES_INDEX_PATTERNS={{ es_index_patterns | default('pitel*') }}
ELASTIC_PASSWORD={{ elastic_password }}
ES_WRITER_USER=es_writer
ES_WRITER_PASS={{ es_writer_pass }}
ES_APP_USER=ccp_app
ES_APP_PASS={{ es_app_pass }}
ES_READER_USER=es_reader
ES_READER_PASS={{ es_reader_pass }}
RMQ_CPUS={{ rmq_cpus | default(1) }}
RMQ_MEM_LIMIT={{ rmq_mem_limit | default('1g') }}
RMQ_VHOST={{ rmq_vhost | default('pitel') }}
RMQ_ADMIN_USER=rmq_admin
RMQ_ADMIN_PASS={{ rmq_admin_pass }}
RMQ_ESWRITER_USER=es_writer
RMQ_ESWRITER_PASS={{ rmq_eswriter_pass }}
RMQ_PUBLISHER_USER=pbx_publisher
RMQ_PUBLISHER_PASS={{ rmq_publisher_pass }}
RMQ_ESWRITER_PERMS='{{ rmq_eswriter_perms | default(".* .* .*") }}'
RMQ_PUBLISHER_PERMS='{{ rmq_publisher_perms | default("^$ .* ^$") }}'
RABBITMQ_ROUTING_KEY={{ rabbitmq_routing_key | default('es.writer') }}
ES_WRITER_REPLICAS={{ es_writer_replicas }}
