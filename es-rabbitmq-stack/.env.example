# DOMAIN, ACME_EMAIL chỉ dùng cho chế độ internet (compose.yaml). Chế độ private bỏ qua.
DOMAIN=es.example.com
ACME_EMAIL=devops@example.com

TRAEFIK_VERSION=v3.7.10
# >= 7.17.15: ES này nhận dữ liệu migrate từ ES của CX2 (7.17.15). Không hạ thấp hơn.
ES_VERSION=7.17.28
RABBITMQ_VERSION=3-management
ES_WRITER_IMAGE=luandnh1998/es-writer:latest

ELASTIC_PASSWORD=CHANGE_ME
RABBITMQ_USER=tel4vn
RABBITMQ_PASS=CHANGE_ME

# IP được vào RabbitMQ GUI (15672), nhiều IP cách nhau dấu phẩy. Mặc định: mạng công ty.
RABBITMQ_GUI_ALLOW_IPS=113.161.95.53/32

# Chỉ dùng cho compose.private.yaml: IP private của server này (cùng mạng với tổng đài).
PRIVATE_IP=
