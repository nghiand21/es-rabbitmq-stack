# =============================================================================
# Copy:  cp .env.example .env && ./scripts/gen-secrets.sh   (sinh mật khẩu ngẫu nhiên)
# Quyền: chmod 600 .env    — KHÔNG commit .env (đã có trong .gitignore)
# Với AWX: file này được render từ ansible/templates/env.j2 + Vault/Credential.
# =============================================================================

STACK_NAME=es-stack
# Chọn cách xin cert: compose.acme-http.yaml (HTTP-01) hoặc compose.acme-dns.yaml (DNS-01)
COMPOSE_FILE=compose.yaml:compose.acme-http.yaml

# ---- Versions (pin cụ thể, nâng cấp qua PR) --------------------------------
TRAEFIK_VERSION=v3.7.10
# Giữ nguyên như hướng dẫn cũ (đã EOL — xem README §Rủi ro còn tồn đọng)
ES_VERSION=7.10.1
RABBITMQ_VERSION=3-management
# Nên mirror về registry nội bộ và pin digest: registry.example.com/pitel/es-writer@sha256:...
ES_WRITER_IMAGE=luandnh1998/es-writer:latest

# ---- Domains & TLS ----------------------------------------------------------
ES_DOMAIN=es.example.com
RMQ_DOMAIN=mq.example.com          # dùng chung cho Management UI (443) và AMQPS (5671)
ACME_EMAIL=devops@example.com
# Test lần đầu bằng staging để tránh rate-limit, sau đó comment dòng này + xoá volume acme
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# Chỉ dùng khi COMPOSE_FILE có compose.acme-dns.yaml
ACME_DNS_PROVIDER=cloudflare

# ---- Network allowlist (CIDR, phân tách dấu phẩy) ----------------------------
# Chỉ IP của PBX/CCP/VPN văn phòng. Tránh 0.0.0.0/0.
ES_ALLOWED_CIDRS=10.0.0.0/8,192.0.2.10/32
RMQ_MGMT_ALLOWED_CIDRS=192.0.2.10/32
AMQP_ALLOWED_CIDRS=10.0.0.0/8,192.0.2.10/32

# ---- Elasticsearch ----------------------------------------------------------
ES_CLUSTER_NAME=es-cluster
ES_HEAP=2g                 # <= 50% ES_MEM_LIMIT
ES_MEM_LIMIT=4g
ES_CPUS=2
ES_REPLICAS=0              # single-node: 0, nếu không index luôn YELLOW
ES_INDEX_PATTERNS=pitel*
ELASTIC_PASSWORD=CHANGE_ME                 # superuser — chỉ dùng cho admin/bootstrap
ES_WRITER_USER=es_writer
ES_WRITER_PASS=CHANGE_ME                   # dùng cho container es-writer
ES_APP_USER=ccp_app
ES_APP_PASS=CHANGE_ME                      # dùng cho CCP/API (read+write document)
ES_READER_USER=es_reader
ES_READER_PASS=CHANGE_ME                   # dùng cho báo cáo/Grafana (read-only)

# ---- RabbitMQ ---------------------------------------------------------------
RMQ_CPUS=1
RMQ_MEM_LIMIT=1g
RMQ_VHOST=pitel
RMQ_ADMIN_USER=rmq_admin
RMQ_ADMIN_PASS=CHANGE_ME                   # login Management UI
RMQ_ESWRITER_USER=es_writer
RMQ_ESWRITER_PASS=CHANGE_ME                # consumer
RMQ_PUBLISHER_USER=pbx_publisher
RMQ_PUBLISHER_PASS=CHANGE_ME               # PBX/CCP publish CDR
# Quyền (regex configure/write/read) — siết lại nếu biết chính xác tên queue/exchange
RMQ_ESWRITER_PERMS='.* .* .*'
RMQ_PUBLISHER_PERMS='^$ .* ^$'

# ---- es-writer --------------------------------------------------------------
RABBITMQ_ROUTING_KEY=es.writer
ES_WRITER_REPLICAS=1        # scale consumer: đổi số này rồi `make up`
